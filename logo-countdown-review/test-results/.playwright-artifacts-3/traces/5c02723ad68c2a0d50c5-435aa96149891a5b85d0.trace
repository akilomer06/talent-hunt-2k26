,["P",{"class":"eligibility"},"For Crescent CSE students only"]],["DIV",{"data-entrance":"","class":""},["DIV",{"class":"event-art art-1  art-hero","aria-hidden":"true","style":"opacity: 1;"},["SPAN",{"class":"art-grid"}],["SPAN",{"class":"art-light"}],["SPAN",{"class":"art-sculpture"}],["SPAN",{"class":"art-orbit"}],["SPAN",{"class":"art-orbit art-orbit-second"}],["SPAN",{"class":"art-type"},"Code Canvas"],["SPAN",{"class":"art-number"},"02"],["svg",{"viewBox":"0 0 240 240","fill":"none","stroke":"currentColor","stroke-width":"4","stroke-linecap":"round","stroke-linejoin":"round"},["rect",{"x":"32","y":"55","width":"176","height":"130","rx":"8"}],["path",{"d":"M32 84h176M47 70h2m12 0h2m12 0h2M55 105h55v54H55zm72 2h58m-58 20h45m-45 20h58"}]],["SPAN",{"class":"art-caption"},["SPAN",{"class":"art-crosshair"},"+"]," TH / 26"," ",["SPAN",{"class":"art-barcode"}]]]]],["SECTION",{"class":"section event-content"},["DIV",{},["P",{"class":"eyebrow"},["SPAN",{"aria-hidden":"true","class":"signal"}],"THE COMPETITION"],["H2",{},"MAKE IT",["BR"],"YOUR MOMENT."],["P",{},"Code Canvas is an exciting 2-hour-and-30-minute AI-powered web development hackathon where participants combine programming skills with Generative AI to build functional web applications. Teams will receive an on-the-spot problem statement and compete through creative coding, a surprise Chaos Round, and a 90-Second Final Boss showdown. Think creatively, code smartly, and turn your ideas into reality!"],["DIV",{"class":"detail-section"},["H2",{},"Rules & Regulations"],["UL",{},["LI",{},"Team Composition: Participate individually or in teams of up to 2 members."],["LI",{},"AI Tool Policy: AI coding assistants such as ChatGPT, DeepSeek, Gemini, Roo Code, and Claude are permitted. Zero-code app generators such as Lovable are strictly prohibited."],["LI",{},"Development: Use AI to assist with prompting, coding, debugging, and refinement. Participants must understand their code."],["LI",{},"Submission: Push the final code to a public GitHub repository within the allotted time. Include a README.md with the project title, team members, and description. Submit a working application."],["LI",{},"Code of Conduct: Projects must be developed during the event. Copying pre-built projects and collaborating with other teams are prohibited."],["LI",{},"Chaos Round: Teams must implement a surprise feature or technical challenge within the announced time limit."],["LI",{},"90-Second Final Boss: Each team gets 90 seconds to demonstrate its application, followed by a brief technical question from the judges."],["LI",{},"AI Transparency: Document the AI tools used, important prompts, AI-generated code modified, at least one bug solved independently, and application testing in README.md or AI-LOG.md."]]],["DIV",{"class":"detail-section"},["H2",{},"Participation Requirements"],["UL",{},["LI",{},"Participate individually or in teams of up to 2 members."],["LI",{},"Organized by CSE CODING CLUB."],["LI",{},"Open to Crescent CSE students only."]]],["DIV",{"class":"detail-section"},["H2",{},"Rounds & Format"],["UL",{},["LI",{},"Round 1 · Agile AI Development: Receive an on-the-spot problem statement and build a functional web application utilizing approved AI assistants."],["LI",{},"Round 2 · Chaos Round: Teams must implement a surprise feature or technical challenge within the announced time limit."],["LI",{},"Round 3 · 90-Second Final Boss: Each team gets 90 seconds to demonstrate its application, followed by a brief technical question from the judges."]]],["DIV",{"class":"detail-section"},["H2",{},"Equipment & Software"],["UL",{},["LI",{},"Laptops with development environment and Git/GitHub setup."],["LI",{},"Permitted AI Coding Assistants: ChatGPT, DeepSeek, Gemini, Roo Code, and Claude."],["LI",{},"Strictly Prohibited: Zero-code app generators such as Lovable."]]],["DIV",{"class":"detail-section"},["H2",{},"Prizes & Judging Criteria"],["UL",{},["LI",{},"Winning Criteria (100 Marks Total):"],["LI",{},"Functionality and working features: 25 Marks"],["LI",{},"Creativity and innovation: 20 Marks"],["LI",{},"UI/UX and responsiveness: 15 Marks"],["LI",{},"AI integration and code understanding: 20 Marks"],["LI",{},"Chaos Round performance: 10 Marks"],["LI",{},"Final demo and technical explanation: 10 Marks"]]]],["ASIDE",{"class":"event-facts"},["SPAN",{"class":"micro"},"AT A GLANCE"],["DL",{},["DT",{},"Category"],["DD",{},"Technical"],["DT",{},"Date"],["DD",{},"26 October 2026"],["DT",{},"Venue"],["DD",{},["STRONG",{},"Venue TBA"],["SPAN",{"class":"venue-campus-note"}," ","· ","Auditorium · B.S. Abdur Rahman Crescent"]],["DT",{},"Eligibility"],["DD",{},"For Crescent CSE students only"]]]],["NAV",{"class":"event-pagination","aria-label":"Events in brochure order"},["A",{"href":"/events/code-break","data-discover":"true"},["SPAN",{"class":"micro"},"← PREVIOUS EVENT"],["STRONG",{},"Code Break"]],["A",{"href":"/events/neural-nexus","data-discover":"true"},["SPAN",{"class":"micro"},"NEXT EVENT →"],["STRONG",{},"Neural Nexus"]]]]]]],["FOOTER",{"class":"site-footer"},["DIV",{"class":"footer-top"},["DIV",{},["P",{"class":"eyebrow"},"YOUR TALENT. YOUR MOMENT."],["A",{"class":"footer-wordmark","href":"/","data-discover":"true"},"TALENT HUNT",["SPAN",{},"2K26"]],["P",{},"Sixteen competitions. Your talent, in the spotlight."]],["DIV",{"class":"footer-nav"},["H2",{},"Explore"],["A",{"href":"/events/technical","data-discover":"true"},"Technical Events"],["A",{"href":"/events/non-technical","data-discover":"true"},"Non-Technical Events"],["A",{"href":"/schedule","data-discover":"true"},"Schedule"],["A",{"href":"/coordinators","data-discover":"true"},"Coordinators"],["A",{"href":"/about","data-discover":"true"},"About"],["A",{"href":"/venue","data-discover":"true"},"Venue"],["A",{"href":"/faqs","data-discover":"true"},"FAQs"],["A",{"href":"/contact","data-discover":"true"},"Contact"]],["DIV",{"class":"footer-connect"},["H2",{},"Stay connected"],["A",{"href":"https://www.instagram.c