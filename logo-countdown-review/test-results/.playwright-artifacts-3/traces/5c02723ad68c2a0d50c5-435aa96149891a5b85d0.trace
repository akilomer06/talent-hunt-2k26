ion Policy: Matches continue uninterrupted without restarts for individual player lag, network drops, or client crashes."],["LI",{},"Cheating & Exploits: Use of unauthorized third-party apps, hacks, macros, scripts, or deliberate glitch exploitation results in immediate disqualification."],["LI",{},"Collusion & Unfair Play: Teaming up with opponents, match-fixing, intentional feeding, or stream-sniping leads to an instant roster ban."],["LI",{},"Credential Leaks & Misconduct: Sharing room passwords outside registered squads, multi-team registrations, or abusive conduct incurs direct expulsion."]]],["DIV",{"class":"detail-section"},["H2",{},"Participation Requirements"],["UL",{},["LI",{},"Format: Squad (4 main players + 1 optional substitute)."],["LI",{},"Perspective: TPP (Third-Person Perspective)."],["LI",{},"Device: Mobile Only."],["LI",{},"Scoring: Standard Matrix."]]],["DIV",{"class":"detail-section"},["H2",{},"Rounds & Format"],["UL",{},["LI",{},"Qualifiers: High-stakes squad matches across Erangel, Miramar, and Sanhok."],["LI",{},"Grand Finals: Top qualifying squads compete in custom championship lobbies for the campus crown."]]],["DIV",{"class":"detail-section"},["H2",{},"Equipment & Software"],["UL",{},["LI",{},"Only handheld mobile smartphones are allowed."],["LI",{},"Strictly Prohibited: Emulators, PCs, tablets, and trigger accessories."]]]],["ASIDE",{"class":"event-facts"},["SPAN",{"class":"micro"},"AT A GLANCE"],["DL",{},["DT",{},"Category"],["DD",{},"Non-Technical"],["DT",{},"Date"],["DD",{},"26 October 2026"],["DT",{},"Venue"],["DD",{},["STRONG",{},"Venue TBA"],["SPAN",{"class":"venue-campus-note"}," ","· ","Auditorium · B.S. Abdur Rahman Crescent"]],["DT",{},"Eligibility"],["DD",{},"For Crescent CSE students only"]]]],["NAV",{"class":"event-pagination","aria-label":"Events in brochure order"},["A",{"href":"/events/the-voice-over","data-discover":"true"},["SPAN",{"class":"micro"},"← PREVIOUS EVENT"],["STRONG",{},"The Voice Over"]],["A",{"href":"/events