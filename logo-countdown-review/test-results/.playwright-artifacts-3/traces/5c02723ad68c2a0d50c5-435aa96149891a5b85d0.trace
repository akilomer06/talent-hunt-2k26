true"},"↗"]],["DIV",{"class":"share"},["BUTTON",{"class":"text-link"},"Copy Link ↗"],["SPAN",{"role":"status"}]]],["P",{"class":"eligibility"},"For Crescent CSE students only"]],["DIV",{"data-entrance":"","class":""},["DIV",{"class":"event-art art-2 art-orange art-hero","aria-hidden":"true","style":"opacity: 1;"},["SPAN",{"class":"art-grid"}],["SPAN",{"class":"art-light"}],["SPAN",{"class":"art-sculpture"}],["SPAN",{"class":"art-orbit"}],["SPAN",{"class":"art-orbit art-orbit-second"}],["SPAN",{"class":"art-type"},"Trashion"],["SPAN",{"class":"art-number"},"03"],["svg",{"viewBox":"0 0 240 240","fill":"none","stroke":"currentColor","stroke-width":"4","stroke-linecap":"round","stroke-linejoin":"round"},["path",{"d":"M101 72c0-26 38-26 38-3 0 13-19 15-19 29v16l84 53c10 7 2 16-9 16H45c-11 0-19-9-9-16l84-53"}]],["SPAN",{"class":"art-caption"},["SPAN",{"class":"art-crosshair"},"+"]," TH / 26"," ",["SPAN",{"class":"art-barcode"}]]]]],["SECTION",{"class":"section event-content"},["DIV",{},["P",{"class":"eyebrow"},["SPAN",{"aria-hidden":"true","class":"signal"}],"THE COMPETITION"],["H2",{},"MAKE IT",["BR"],"YOUR MOMENT."],["P",{},"Trashion is a creative fashion event that combines fashion with sustainability. Participants must design and showcase unique outfits made from reusable, recycled, and waste materials. The event encourages students to transform discarded items into fashionable creations while promoting environmental awareness and sustainable fashion. The goal is to prove that waste can be transformed into fashion through creativity and innovation. Turn Trash into Trend. Make Sustainability Stylish!"],["DIV",{"class":"detail-section"},["H2",{},"Rules & Regulations"],["UL",{},["LI",{},"Team Size: Each team must consist of exactly 5 members."],["LI",{},"Team Categories: Separate Boys’ Teams and Girls’ Teams are allowed. Mixed-gender teams are not permitted."],["LI",{},"Theme: All outfits must follow the theme “Trashion – Fashion from Reusable and Recycled Materials.”"],["LI",{},"Materials: Participants must primarily use reusable, recycled, or discarded materials such as newspapers, cardboard, plastic bottles, old clothes, fabric scraps, packaging materials, CDs, and other safe waste materials."],["LI",{},"Originality: Outfits must be creative and original. Participants are encouraged to design and prepare their costumes before the event."],["LI",{},"Time Limit: Each team will be allotted a maximum of 7 minutes for the entire performance, including the ramp walk, introduction, and presentation."],["LI",{},"Theme Compliance: Outfits that do not follow the Trashion theme may receive reduced marks or be disqualified at the judges’ discretion."],["LI",{},"Appropriate Attire: All outfits must be decent and suitable for a college-level event. Vulgarity, offensive messages, or inappropriate behaviour will not be tolerated."],["LI",{},"Safety: Sharp objects, hazardous waste, flammable materials, toxic substances, and other dangerous items are strictly prohibited."],["LI",{},"Music and Audio: All background music and audio tracks must be submitted to the organisers at least 2 days before the event."],["LI",{},"Reporting Time: All participants must report to the venue at least 2 hours before the event for registration, costume preparation, and performance slot allocation."],["LI",{},"Props and Accessories: Teams are responsible for bringing their own costumes, props, accessories, and other required materials."],["LI",{},"Time Penalty: Marks may be deducted for exceeding the allotted time limit."],["LI",{},"Disqualification: Teams may be disqualified for violating event rules, using prohibited materials, displaying inappropriate behaviour, or failing to follow the theme."],["LI",{},"Judges’ Decision: The judges’ decision will be final and binding."],["LI",{},"Organisers’ Authority: The organisers reserve the right to make necessary changes to the event schedule, rules, or performance order when required."]]],["DIV",{"class":"detail-section"},["H2",{},"Participation Requirements"],["UL",{},["LI",{},"Team Size: Exactly 5 members per team."],["LI",{},"Categories: Separate Boys' Teams and Girls' Teams. Mixed-gender teams are not permitted."],["LI",{},"Reporting Time: At least 2 hours before the event."]]],["DIV",{"class":"detail-section"},["H2",{},"Rounds & Format"],["UL",{},["LI",{},"7-Minute Ramp Walk & Presentation: Each team is allotted a maximum of 7 minutes for the entire performance, including the ramp walk, introduction, and concept presentation."]]],["DIV",{"class":"detail-section"},["H2",{},"Equipment & Software"],["UL",{},["LI",{},"Reusable, recycled, or discarded materials (newspapers, cardboard, plastic bottles, old clothes, fabric scraps, packaging materials, CDs, etc.)."],["LI",{},"Strictly Prohibited: Sharp objects, hazardous waste, flammable materials, toxic substances, and dangerous items."]]],["DIV",{"class":"detail-section"},["H2",{},"Prizes & Judging Criteria"],["UL",{},["LI",{},"Judging Focus Criteria:"],["LI",{},"1. Creativity and Innovation: Uniqueness of outfit and design concept."],["LI",{},"2. Effective Use of Recycled Materials: How well reusable and discarded materials are incorporated."],["LI",{},"3. Theme Relevance: How clearly the designs represent the Trashion theme."],["LI",{},"4. Styling and Presentation: Outfit coordination, styling, and overall visual appeal."],["LI",{},"5. Ramp Walk and Confidence: Confidence, stage presence, and coordination."],["LI",{},"6. Sustainability Message: Communication of recycling, reuse, and environmental protection."],["LI",{},"7. Overall Impact: Creativity, presentation, and impression on audience and judges."]]]],["ASIDE",{"class":"event-facts"},["SPAN",{"class":"micro"},"AT A GLANCE"],["DL",{},["DT",{},"Category"],["DD",{},"Non-Technical"],["DT",{},"Date"],["DD",{},"26 October 2026"],["DT",{},"Venue"],["DD",{},["STRONG",{},"Venue TBA"],["SPAN",{"class":"venue-campus-note"}," ","· ","Auditorium · B.S. Abdur Rahman Crescent"]],["DT",{},"Eligibility"],["DD",{},"For Crescent CSE students only"]]]],["NAV",{"class":"event-pagination","aria-label":"Events in brochure order"},["A",{"href":"/events/clue-code","data-discover":"true"},["SPAN",{"class":"micro"},"← PREVIOUS EVENT"],["STRONG",{},"Clue Code"]],["A",{"href":"/events/the-voice-over","data-discover":"true"},["SPAN",{"class":"micro"},"NEXT EVENT →"],["STRONG",{},"The Voice Over"]]]]]]],["FOOTER",{"class":"site-footer"},["DIV",{"class":"footer-top"},["DIV",{},["P",{"class":"eyebrow"},"YOUR TALENT. YOUR MOMENT."],["A",{"class":"footer-wordmark","href":"/","data-discover":"true"},"TALENT HUNT",["SPAN",{},"2K26"]],["P",{},"Sixteen competitions. Your talent, in the spotlight."]],["DIV",{"class":"footer-nav"},["H2",{},"Explore"],["A",{"href":"/events/technical","data-discover":"true"},"Technical Events"],["A",{"href":"/events/non-technical","data-discover":"true"},"Non-Technical Events"],["A",{"href":"/schedule","data-discover":"true"},"Schedule"],["A",{"href":"/coordinators","data-discover":"true"},"Coordinators"],["A",{"href":"/about","data-discover":"true"},"About"],["A",{"href":"/venue","data-discover":"true"},"Venue"],["A",{"href":"/faqs","data-discover":"true"},"FAQs"],["A",{"href":"/contact","data-discover":"true"},"Contact"]],["DIV",{"class":"footer-connect"},["H2",{},"Stay connected"],["A",{"href":"https://www.instagram.com/talent.hunt.2k26/","target":"_blank","rel":"noopener noreferrer"},"@talent.hunt.2k26"," ↗"],["A",{"class":"text-link","href":"/assets/documents/brochure-qr.jpg","target":"_blank","rel":"noopener noreferrer"},"View Official Brochure ",["SPAN",{"aria-hidden":"true"},"↗"]],["A",{"href":"/register","data-discover":"true"},"Registration ↗"],["A",{"href":"/privacy","data-discover":"true"},"Privacy & your data"]]],["DIV",{"class":"footer-logos"},["IMG",{"__playwright_current_src__":"","class":"college-logo","width":"240","height":"67","loading":"lazy","src":"/assets/logos/crescent.png","alt":"B.S. Abdur Rahman Crescent Institute of S