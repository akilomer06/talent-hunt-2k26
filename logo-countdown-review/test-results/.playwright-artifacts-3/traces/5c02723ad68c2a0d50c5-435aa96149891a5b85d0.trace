,["DIV",{"class":"share"},["BUTTON",{"class":"text-link"},"Copy Link ↗"],["SPAN",{"role":"status"}]]],["P",{"class":"eligibility"},"For Crescent CSE students only"]],["DIV",{"data-entrance":"","class":""},["DIV",{"class":"event-art art-3  art-hero","aria-hidden":"true","style":"opacity: 1;"},["SPAN",{"class":"art-grid"}],["SPAN",{"class":"art-light"}],["SPAN",{"class":"art-sculpture"}],["SPAN",{"class":"art-orbit"}],["SPAN",{"class":"art-orbit art-orbit-second"}],["SPAN",{"class":"art-type"},"Binary Battle"],["SPAN",{"class":"art-number"},"04"],["svg",{"viewBox":"0 0 240 240","fill":"none","stroke":"currentColor","stroke-width":"4","stroke-linecap":"round","stroke-linejoin":"round"},["rect",{"x":"65","y":"65","width":"110","height":"110","rx":"15"}],["rect",{"x":"89","y":"89","width":"62","height":"62","rx":"3"}],["path",{"d":"M85 40v25m0 110v25M40 85h25m110 0h25"}],["path",{"d":"M120 40v25m0 110v25M40 120h25m110 0h25"}],["path",{"d":"M155 40v25m0 110v25M40 155h25m110 0h25"}]],["SPAN",{"class":"art-caption"},["SPAN",{"class":"art-crosshair"},"+"]," TH / 26"," ",["SPAN",{"class":"art-barcode"}]]]]],["SECTION",{"class":"section event-content"},["DIV",{},["P",{"class":"eyebrow"},["SPAN",{"aria-hidden":"true","class":"signal"}],"THE COMPETITION"],["H2",{},"MAKE IT",["BR"],"YOUR MOMENT."],["P",{},"Binary Battle is an intense three-stage technical competition that tests speed, binary decoding, analytical problem solving, and product marketing. Teams decode secret coordinates to find their workstation, race through a locked 3x3 technical quiz grid, and deliver an innovative on-the-spot product pitch."],["DIV",{"class":"detail-section"},["H2",{},"Rules & Regulations"],["UL",{},["LI",{},"No electronics are allowed for the first two rounds. This includes mobile phones, laptops, earphones, and other devices."],["LI",{},"Cross collaboration across different teams is not allowed and could lead to penalty scores or termination."],["LI",{},"For any issues or queries, participants are expected to approach the volunteers and not other teams."],["LI",{},"Winners will be selected with their time of completion and their presentation scores. In case of ties, a new round of problem solving shall be introduced between the teams."],["LI",{},"Judges and Organizers have the power to disqualify teams for unfair practices."]]],["DIV",{"class":"detail-section"},["H2",{},"Participation Requirements"],["UL",{},["LI",{},"Team size: 2 - 3 members."],["LI",{},"Cross collaboration across teams is strictly prohibited."],["LI",{},"Venue: ES 304."]]],["DIV",{"class":"detail-section"},["H2",{},"Rounds & Format"],["UL",{},["LI",{},"Round 1 · Identifying workstation from binary data: Participants receive individual IDs which on matching with their team's ID provide a meaningful image. Teams move to the Bay Area to obtain a scroll containing binary data to decode and identify the workstation on which the team has to assemble."],["LI",{},"Round 2 · Decoding the image by solving technical quiz: Each team receives a 3x3 grid on their workstation which has a hidden image. Solve quizzes to unlock each segment. After solving all segments, identify what the unlocked image represents and report to event organisers."],["LI",{},"Round 3 · Advertising the given product: Upon reaching this final round, participants are allowed laptops, mobile phones, and internet access to advertise and market a surprise product provided on spot. Showcase creativity, innovation, and professional communication."]]],["DIV",{"class":"detail-section"},["H2",{},"Equipment & Software"],["UL",{},["LI",{},"Materials to be brought: Laptop and Mobile Phones (permitted in Round 3)."],["LI",{},"No electronics are permitted during the first two rounds."],["LI",{},"Internet access will be provided for the final advertising round."]]]],["ASIDE",{"class":"event-facts"},["SPAN",{"class":"micro"},"AT A GLANCE"],["DL",{},["DT",{},"Category"],["DD",{},"Technical"],["DT",{},"Date"],["DD",{},"26 October 2026"],["DT",{